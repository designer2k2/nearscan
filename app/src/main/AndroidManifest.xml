<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- WiFi scanning -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Location (required for WiFi/BT scan results, single GPS fix). Android 12+ only shows the
         runtime dialog's precise-location option when COARSE is requested alongside FINE in the
         same request; RequiredPermissions.forScanning() requests both together. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Bluetooth (Android 12+). No neverForLocation: the app already holds FINE location and
         geo-stamps every BT/BLE record, so deriving location from scan results costs nothing and
         without this flag iBeacon/Eddystone-style advertisements would otherwise be filtered out. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Cell info -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Legacy export storage -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Keep CPU alive -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Persistent foreground-service notification (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Detects a reboot ending an active session, to prompt the user to resume -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Exempt from Doze/App Standby so the foreground scan service survives hours/days
        stationary — the core use case of the app. User-triggered only, via the
        BatteryOptimizationBanner in MainScreen — never requested automatically on launch
        (that used to happen and stole focus from the app's first frame, breaking Robo tests).
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- MQTT -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Tasker / automation integration: callers need this to query the ContentProvider -->
    <uses-permission android:name="at.designer2k2.nearscan.permission.READ_DATA" />

    <!--
        Normal protection level = namespace guard, not a hard security gate.
        Any app that declares <uses-permission> for this is granted it silently.
        Change to "dangerous" if stricter access control is needed in the future.
    -->
    <permission
        android:name="at.designer2k2.nearscan.permission.READ_DATA"
        android:protectionLevel="normal" />

    <application
        android:name=".NearScanApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NearScan"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NearScan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.ScanService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Tasker / automation: receives control commands (CMD_START, CMD_STOP, etc.) -->
        <receiver
            android:name=".ipc.CommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="at.designer2k2.nearscan.CMD_START" />
                <action android:name="at.designer2k2.nearscan.CMD_STOP" />
                <action android:name="at.designer2k2.nearscan.CMD_TOGGLE" />
                <action android:name="at.designer2k2.nearscan.CMD_EXPORT" />
                <action android:name="at.designer2k2.nearscan.CMD_SET_LOCATION" />
                <action android:name="at.designer2k2.nearscan.CMD_SET_INTERVAL" />
                <action android:name="at.designer2k2.nearscan.CMD_CLEAR_DATA" />
            </intent-filter>
        </receiver>

        <!-- Detects a reboot that ended an active scan session, to prompt the user to resume.
             BOOT_COMPLETED is a protected broadcast only the system can send, so this doesn't
             need to be exported to other apps. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Tasker / automation: exposes live scan data via Content Query action -->
        <provider
            android:name=".ipc.NearScanContentProvider"
            android:authorities="at.designer2k2.nearscan.provider"
            android:exported="true"
            android:readPermission="at.designer2k2.nearscan.permission.READ_DATA" />

        <!-- Grants the share-sheet target temporary read access to exported files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="at.designer2k2.nearscan.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
